<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="retail.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1314"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="retail_sales_raw" custom_title="0" dock_id="1" table="4,16:mainretail_sales_raw"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">SELECT * FROM retail_sales_raw LIMIT 10;
















SELECT Region,round(sum(Sales),2)as Total_Sales
FROM retail_sales_raw
GROUP by Region
ORDER by  Total_Sales desc;

SELECT UPPER(SUBSTR(Region,1,1)) || LOWER(SUBSTR(Region,2)) AS Clean_Region,
       ROUND(SUM(Sales),2) AS Total_Sales
FROM retail_sales_raw
WHERE Region IS NOT NULL
GROUP BY Clean_Region
ORDER BY Total_Sales DESC;

SELECT Category, ROUND(SUM(Sales),2) AS Total_Sales, ROUND(SUM(Profit),2) AS Total_Profit
FROM retail_sales_raw
GROUP BY Category
ORDER BY Total_Sales DESC;

SELECT strftime('%Y-%m', &quot;Order Date&quot;) AS Month, ROUND(SUM(Sales),2) AS Total_Sales
FROM retail_sales_raw
GROUP BY Month
ORDER BY Month;

SELECT
  CASE
    WHEN &quot;Order Date&quot; LIKE '_--_' THEN strftime('%Y-%m', &quot;Order Date&quot;)
    ELSE strftime('%Y-%m', substr(&quot;Order Date&quot;,7,4) || '-' || substr(&quot;Order Date&quot;,4,2) || '-' || substr(&quot;Order Date&quot;,1,2))
  END AS Month,
  ROUND(SUM(Sales),2) AS Total_Sales
FROM retail_sales_raw
GROUP BY Month
ORDER BY Month;

SELECT Category, ROUND(SUM(Profit)*100.0/SUM(Sales), 2) AS Profit_Margin_Pct
FROM retail_sales_raw
GROUP BY Category
ORDER BY Profit_Margin_Pct DESC;

SELECT
  CASE
    WHEN Discount = 0 THEN 'No Discount'
    WHEN Discount &lt;= 0.15 THEN 'Low (upto 15%)'
    WHEN Discount &lt;= 0.3 THEN 'Medium (upto 30%)'
    ELSE 'High (&gt;30%)'
  END AS Discount_Band,
  ROUND(AVG(Profit),2) AS Avg_Profit
FROM retail_sales_raw
GROUP BY Discount_Band
ORDER BY Avg_Profit DESC;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
